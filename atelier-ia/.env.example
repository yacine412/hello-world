# Copiez ce fichier sous le nom ".env" puis collez votre clé.
# La clé reste sur votre ordinateur : elle n'est jamais envoyée au navigateur.
ANTHROPIC_API_KEY=

# Modèle utilisé (facultatif). Par défaut : claude-opus-5-5
# AI_MODEL=claude-opus-5-5

# Port de l'application (facultatif). Par défaut : 3000
# PORT=3000

# Dossier où sont enregistrés vos projets (facultatif). Par défaut : ./data
# DATA_DIR=./data
